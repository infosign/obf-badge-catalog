# Open Badge Factory API credentials
# クライアント管理画面 (Admin tools > API key) で発行した API key を
# obf-token-tool 等で client_id / client_secret に分解して設定する。
OBF_CLIENT_ID=your-client-id
OBF_CLIENT_SECRET=your-client-secret
# 任意: API のベース URL (既定は https://openbadgefactory.com)
# OBF_API_BASE=https://openbadgefactory.com
